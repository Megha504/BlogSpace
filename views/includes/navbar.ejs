<nav class="navbar navbar-expand-lg bg-light shadow-sm sticky-top py-2 mb-2">
  <div class="container-fluid">

    <!-- Brand -->
    <a class="navbar-brand fw-bold text-primary d-flex align-items-center" href="/posts">
      <i class="fa-solid fa-blog fs-4"></i>
      <span class="d-none d-md-inline ms-2">BlogSpace</span>
    </a>

    <!-- Toggle for small screens -->
   <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNavDropdown"
  style="padding: 0.25rem 0.5rem;">
  <span class="navbar-toggler-icon" style="width: 1.2rem; height: 1.2rem;"></span>
</button>


    <!-- Always-visible Search Bar -->
 <% if (currRoute !== "/login" && currRoute !== "/signup") { %>
  <!-- Responsive Search Bar -->
  <div class="flex-grow-1 d-flex justify-content-center px-2">
    <div class="position-relative w-100 w-md-75">
      <form class="d-flex w-100" role="search" onsubmit="return false;">
        <input 
          class="form-control me-2" 
          type="search" 
          name="q" 
          placeholder="Search posts..." 
          aria-label="Search"
          id="SearchInput"
        >
        <button class="btn btn-outline-primary" type="submit" id="SearchBtn">Search</button>
      </form>
      <!-- AJAX Results Dropdown -->
      <div 
        id="searchResults" 
        class="position-absolute bg-white shadow p-3 rounded w-100" 
        style="top: 100%; left: 0; display: none; z-index: 1050;">
      </div>
    </div>
  </div>
<% } %>


    <!-- Right Nav Items -->
    <div class="collapse navbar-collapse justify-content-end mt-2 mt-lg-0" id="navbarNavDropdown">
      <ul class="navbar-nav">
        <li class="nav-item">
          <a class="nav-link fw-semibold" href="/posts/new">Create Post</a>
        </li>

        <% if (!currUser) { %>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/signup">Sign up</a>
          </li>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/login">Log in</a>
          </li>
        <% } else { %>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/Blogs">Posts</a>
          </li>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/profile">Profile</a>
          </li>
          <li class="nav-item">
            <a class="nav-link fw-semibold" href="/logout">Logout</a>
          </li>
        <% } %>
      </ul>
    </div>

  </div>
</nav>