<% layout("/layouts/boilerplate") %>

<div class="row justify-content-center mt-5">
  <div class=" card shadow p-3 mb-5  col-md-4 bg-body-tertiary p-4 rounded mb-4" style=" box-shadow: 
    0 4px 6px rgba(255, 255, 255, 0.7)">
    <h2 class="mb-4 text-center">Login</h2>

    <form action="/login" method="POST" novalidate class="needs-validation">
      <div class="mb-3">
        <label for="username" class="form-label">Username</label>
        <input type="text" id="username" name="username" class="form-control" required>
      </div>
      
      <div class="mb-3">
        <label for="password" class="form-label">Password</label>
        <input type="password" id="password" name="password" class="form-control" required>
      </div>
      <button class="btn btn-primary w-45 mb-3 mt-2 offset-5">Login</button>
    </form>

    <p class="text-center mb-0">
      Don't have an account?
      <a href="/signup" class="link-primary link-offset-2 link-underline-opacity-0 link-underline-opacity-100-hover">
        Sign up here
      </a>
    </p>
  </div>
</div>
