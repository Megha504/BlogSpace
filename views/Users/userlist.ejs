<% layout("/layouts/boilerplate") %>

<div class="container mt-5">
  <h2 class="mb-4 text-center">All Registered Users</h2>

  <div class="table-responsive">
    <table class="table table-bordered table-hover table-striped align-middle shadow-sm">
      <thead class="table-dark text-center">
        <tr>
          <th>#</th>
          <th>Profile</th>
          <th>Username</th>
          <th>Email</th>
          <th>Role</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody class="text-center">
        <% users.forEach((user, index) => { 
            const defaultProfileImg = "https://cdn-icons-png.flaticon.com/512/149/149071.png";
            const profileImg = user.profileImage?.url || defaultProfileImg;
        %>
          <tr>
            <td><%= index + 1 %></td>
            <td>
              <img src="<%= profileImg %>" 
                   class="rounded-circle border"
                   style="height: 50px; width: 50px; object-fit: cover;" 
                   alt="Profile Image" 
                   title="<%= user.username || 'User' %>">
            </td>
            <td><strong><%= user.username || 'N/A' %></strong></td>
            <td><%= user.email %></td>
            <td>
              <% if (user.isAdmin) { %>
                <span class="badge bg-success">Admin</span>
              <% } else { %>
                <span class="badge bg-secondary">User</span>
              <% } %>
            </td>
            <td>
              <a href="/admin/dashboard/users/<%= user._id %>" class="btn btn-sm btn-outline-primary me-1" title="View Profile">
                <i class="fas fa-user"></i>
              </a>
              <form action="/admin/dashboard/users/<%= user._id %>?_method=DELETE" method="POST" class="d-inline">
                <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete User"
                  onclick="return confirm('Are you sure you want to delete this user?')">
                  <i class="fas fa-trash"></i>
                </button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>
