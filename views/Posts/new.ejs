<% layout("/layouts/boilerplate") %>


<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.js"></script>

<div class="container mt-3" style="max-width: 800px;">
  <h2 class="mb-3">Create New Blog Post</h2>

  <form action="/posts" method="POST" enctype="multipart/form-data" novalidate class="needs-validation">

    <!-- Title -->
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input type="text" id="title" name="post[title]" class="form-control" required>
    </div>

    <!-- Cover Image -->
    <div class="mb-3">
      <label class="form-label">Upload Image</label>
      <input type="file" name="post[coverImage]" class="form-control" required>
    </div>

    <!-- Category -->
    <div class="mb-3">
      <label for="category" class="form-label">Category</label>
      <input type="text" id="category" name="post[category]" class="form-control" placeholder="e.g. Travel, Technology" required>
    </div>

    <!-- Tags -->
    <div class="mb-3">
      <label for="tags" class="form-label">Tags</label>
      <input type="text" id="tags" name="post[tags]" class="form-control" placeholder="e.g. #India #Summer #Beaches" required>
    </div>

    <!-- Summernote Editor -->
    <div class="mb-3">
      <label for="summernote" class="form-label">Post Body</label>
      <textarea id="summernote" class="form-control" required></textarea>
      <div class="invalid-feedback">Please enter blog content</div>
      <input type="hidden" name="post[body]" id="body" />
    </div>

    <!-- Submit -->
    <button type="submit" class="btn mb-3" style="background-color:#3F51B5; color:white">Create Post</button>
  </form>
</div>

<script>
  $(document).ready(function () {
    $('#summernote').summernote({
      height: 300,
      placeholder: 'Write your blog content here...',
      toolbar: [
        ['style', ['bold', 'italic', 'underline', 'clear']],
        ['font', ['fontsize', 'color']],
        ['para', ['ul', 'ol', 'paragraph']],
       
      ]
    });

    // Sync content to hidden input before form submit
    $('form').on('submit', function () {
      $('#body').val($('#summernote').summernote('code'));
    });
  });
</script>
