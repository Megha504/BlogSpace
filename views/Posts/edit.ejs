<% layout("/layouts/boilerplate") %>

<!-- ✅ Summernote CSS + JS (CDN) -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.css" rel="stylesheet">
<script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.1/jquery.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/summernote/0.8.20/summernote-lite.min.js"></script>

<div class="container mt-4" style="max-width: 800px;">
  <h2 class="mb-3">Edit Blog Post</h2>

  <form action="/posts/<%= post._id %>?_method=PUT" method="POST" enctype="multipart/form-data">

    <!-- Title -->
    <div class="mb-3">
      <label for="title" class="form-label">Title</label>
      <input type="text" id="title" name="post[title]" value="<%= post.title %>" class="form-control" required>
    </div>

    <!-- Image -->
    <div class="mb-3">
      <label>Original Image:</label><br>
      <img src="<%= originalimageurl %>" style="max-height: 200px;" class="img-fluid mb-2" />
    </div>

    <div class="mb-3">
      <label for="coverImage" class="form-label">Upload New Image</label>
      <input type="file" id="coverImage" name="post[coverImage]" class="form-control">
    </div>

    <!-- Category & Tags -->
    <div class="mb-3">
      <label for="category" class="form-label">Category</label>
      <input type="text" id="category" name="post[category]" class="form-control" value="<%= post.category %>" required>
    </div>

    <div class="mb-3">
      <label for="tags" class="form-label">Tags</label>
      <input type="text" id="tags" name="post[tags]" class="form-control" value="<%= post.tags.join(', ') %>" required>

    </div>

    <!-- ✅ Summernote Editor -->
    <div class="mb-3">
      <label for="summernote" class="form-label">Post Body</label>
      <textarea id="summernote" class="form-control"><%- post.body %></textarea>
      <input type="hidden" name="post[body]" id="body" />
    </div>

    <button type="submit" class="btn btn-primary mb-3">Update Post</button>
  </form>
</div>

<script>
  $(document).ready(function () {
    $('#summernote').summernote({
      height: 250,
      placeholder: 'Write your content here...',
      toolbar: [
        ['style', ['bold', 'italic', 'underline', 'clear']],
        ['font', ['fontsize', 'color']],
        ['para', ['ul', 'ol', 'paragraph']],
        ['insert'],
        ['view', ['codeview']]
      ]
    });

    // Before submitting, put content into hidden input
    $('form').on('submit', function () {
      $('#body').val($('#summernote').summernote('code'));
    });
  });
</script>
